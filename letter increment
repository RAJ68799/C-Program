#include <stdio.h>

int main()
{
    char str[100];
    int num, count = 0;

    scanf("%[^\n]", str);
    scanf("%d", &num);

    for(int i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == ' ')
        {
            continue;
        }
        else
        {
            str[i]=str[i]+num;
        }

    }
    printf("%s",str);
    return 0;
}
